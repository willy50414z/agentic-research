# curl -X POST http://localhost:7204/api/access-tokens -H "Content-Type: application/json" -d "{\"emailOrUsername\": \"agentic@local.dev\",\"password\": \"agentic-planka-pwd\"}"
PLANKA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImE2MWRjMDE0LTJmYWUtNDY1ZS1iYjRhLWY0ZDNmY2RiZmRjZCJ9.eyJpYXQiOjE3Nzg1OTU5MTYsImV4cCI6MTgxMDEzMTkxNiwic3ViIjoiMTc2NzU3OTAyOTYxMjc5MDc4NSJ9.EXJbICSDP4EiEYQ2QFasSJC3elBiUsm7uhwGbHi3zpk
# 從 Board URL 取得：http://localhost:7002/board/<BOARD_ID>
PLANKA_BOARD_ID=1737635724905153542

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:7201
MINIO_ROOT_USER=agentic-minio-user
MINIO_ROOT_PASSWORD=agentic-minio-pwd

# ── LLM 整合 ─────────────────────────────────────────────────────────────────
# 支援兩種模式：
#   cli = 使用已安裝的 CLI 工具（需在 container 內完成登入）
#   api = 直接使用 API Key（無需 CLI 登入）
#
# LLM_CHAIN：指定 provider，逗號分隔，依序 fallback
# 可用值：claude-cli, claude-api,gemini-cli, gemini-api, openai-api, local
LLM_CHAIN=opencode-cli,opencode-cli

# ── Per-stage LLM 路由 ───────────────────────────────────────────────────────
# 每個 stage 透過 app.llm.get_llm_targets(stage) 讀取對應的 LLM_<STAGE> 變數。
# 值為 LLMTarget enum 的 comma-separated list：claude | gemini | codex | opencode | copilot
# 依序作為 fallback chain（第一個失敗才 fallback 下一個）。
# 未設則由 LLM_DEFAULT 兜底，最終 fallback 為 "claude"。
#
# Stage key 與呼叫位置：
#   freqtrade_steps         — app/freqtrade/steps/_common.py:_call_llm
#   revise_llm1             — Stage A 修訂方向提出（LLM1）
#   revise_llm2             — Stage B 修訂方向審核 + Stage C checklist 翻譯（LLM2）
#   revise_audit            — Stage E logic items 審核（LLM3）
#   spec_review_initial     — spec review 首輪
#   spec_review_synthesize  — spec review 合成最終版本

LLM_DEFAULT=opencode,claude

LLM_FREQTRADE_STEPS=opencode,claude
LLM_REVISE_LLM1=opencode,claude
LLM_REVISE_LLM2=opencode,claude
LLM_REVISE_AUDIT=opencode,claude
LLM_SPEC_REVIEW_INITIAL=opencode,claude
LLM_SPEC_REVIEW_SYNTHESIZE=opencode,claude

# --- CLI 模式（LLM_CHAIN 含 claude-cli / gemini-cli）---
# CLI credential 目錄會從 host mount 進 container（唯讀），無需在 container 內重新登入
# Windows 範例：C:/Users/<username>/.claude
# Linux/Mac 範例：~/.claude（預設值，可省略）
LOCAL_CLAUDE_CONFIG_DIR=C:\Users\willy\.claude
CLAUDE_CONFIG_DIR=C:\Users\willy\.claude
CLAUDE_CODE_GIT_BASH_PATH=E:\software\git\usr\bin\bash.exe

LOCAL_GEMINI_CONFIG_DIR=C:\Users\willy\.gemini
GEMINI_CONFIG_DIR=C:\Users\willy\.gemini

LOCAL_CODEX_CONFIG_DIR=C:\Users\willy\.codex
CODEX_CONFIG_DIR=C:\Users\willy\.codex

# --- API 模式（LLM_CHAIN 含 claude-api / gemini-api / openai-api）---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 本地 LLM（LLM_CHAIN=local，需先在 host 啟動 Ollama）---
LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434
LOCAL_LLM_MODEL=llama3.2
